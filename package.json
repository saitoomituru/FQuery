{
  "name": "fquery-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "FQuery (Q) recursive FAM query driver workspace",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/hosts/*",
    "plugins/*"
  ],
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run build",
    "test": "npm run test --workspaces --if-present",
    "pretypecheck": "npm run build",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
